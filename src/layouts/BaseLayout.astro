---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Complexity — Jacob Rockwell',
  description = 'Notes on building products, systems, and experiments by Jacob Rockwell.'
} = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e1253" />
    <script is:inline>
      // Apply the preference before the page paints, including on navigation.
      (() => {
        let savedTheme;
        try { savedTheme = localStorage.getItem('complexity-theme'); } catch {}
        const theme = savedTheme === 'light' || savedTheme === 'dark'
          ? savedTheme
          : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#0e1253' : '#f5f7fc';
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Complexity home">
        complexity
      </a>
      <div class="header-actions">
        <nav aria-label="Primary navigation">
          <a aria-current={pathname.startsWith('/blog') ? 'page' : undefined} href="/blog/">Writing</a>
          <a aria-current={pathname === '/about/' ? 'page' : undefined} href="/about/">About</a>
          <a href="https://github.com/jrockw" rel="me">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
        <button class="theme-toggle" type="button" role="switch" aria-checked="true" aria-label="Night mode" data-theme-toggle disabled>
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z" />
          </svg>
          <span class="theme-label-day" aria-hidden="true">Day</span>
          <span class="theme-label-night" aria-hidden="true">Night</span>
        </button>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <a class="footer-brand" href="/">complexity</a>
      <p>Jacob Rockwell · Los Angeles, CA</p>
      <a class="footer-top" href="#main-content">Back to top ↑</a>
    </footer>
  </body>
</html>

<script>
  type Theme = 'light' | 'dark';
  const storageKey = 'complexity-theme';
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  const readPreference = (): Theme | null => {
    try {
      const saved = localStorage.getItem(storageKey);
      return saved === 'light' || saved === 'dark' ? saved : null;
    } catch {
      return null;
    }
  };
  let preference = readPreference();

  const applyTheme = (theme: Theme) => {
    document.documentElement.dataset.theme = theme;
    toggle?.setAttribute('aria-checked', String(theme === 'dark'));
    if (toggle) toggle.title = theme === 'dark' ? 'Switch to day mode' : 'Switch to night mode';
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (meta) meta.content = getComputedStyle(document.documentElement).getPropertyValue('--ground').trim();
    window.dispatchEvent(new Event('complexity:theme-change'));
  };

  applyTheme(preference ?? (systemTheme.matches ? 'dark' : 'light'));
  if (toggle) toggle.disabled = false;
  toggle?.addEventListener('click', () => {
    preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem(storageKey, preference); } catch { /* Still switch when storage is unavailable. */ }
    applyTheme(preference);
  });
  systemTheme.addEventListener('change', () => {
    if (!preference) applyTheme(systemTheme.matches ? 'dark' : 'light');
  });
  window.addEventListener('storage', (event) => {
    if (event.key !== storageKey && event.key !== null) return;
    preference = readPreference();
    applyTheme(preference ?? (systemTheme.matches ? 'dark' : 'light'));
  });
</script>
